# Répertoire des données persistantes (SQLite + justificatifs).
DATA_DIR=./data
# Chemins fins (par défaut dérivés de DATA_DIR).
# DATABASE_PATH=./data/sharemate.sqlite
# UPLOADS_DIR=./data/uploads
# DOCUMENTS_DIR=./data/documents
# Répertoire du front compilé servi en production.
# WEB_DIST_DIR=./web/dist
PORT=3000
# En production : active cookie Secure, trustProxy et logs JSON niveau info.
# NODE_ENV=production

# --- Stockage des fichiers : bucket S3 / Cloudflare R2 (optionnel) ---
# Justificatifs de dépense et documents d'équipement partagent le même bucket, sous les préfixes
# receipts/ et documents/. Sans ces quatre variables, ils sont écrits dans UPLOADS_DIR et
# DOCUMENTS_DIR (aucune infra requise).
# Le bucket doit rester PRIVÉ : l'application émet une URL signée de 5 minutes après avoir
# vérifié le cercle de l'équipement. Voir la section « Stockage des fichiers » du README —
# la bascule ne demande aucune coupure, et `npm run migrate:receipts` vide ensuite le volume.
#
# S3_BUCKET=sharemate
# S3_ENDPOINT=https://<id-de-compte>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Notifications push (optionnel) ---
# Sans ces variables, seul le centre de notifications in-app fonctionne (aucune infra requise).
# Voir docs/notifications.md pour la procédure complète.
#
# Web Push (PWA) — générer avec : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@exemple.fr
#
# Push natif Android (FCM) — JSON du compte de service Firebase (sur une seule ligne).
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
